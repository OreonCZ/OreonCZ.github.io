---
import { portfolioData } from '../data/portfolio';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] py-12 bg-[#060910]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="text-sm text-slate-400 text-center sm:text-left">
      <span>&copy; {currentYear} {portfolioData.personal.name}. All rights reserved.</span>
      <div class="text-xs text-slate-400 mt-1">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 underline decoration-white/20">Astro</a> &amp; <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 underline decoration-white/20">Tailwind CSS</a>.
      </div>
    </div>

    <div class="flex items-center gap-6 text-sm text-slate-400">
      <a href="#about" class="hover:text-white transition-colors">About</a>
      <a href="#projects" class="hover:text-white transition-colors">Projects</a>
      <a href="#skills" class="hover:text-white transition-colors">Skills</a>
      <a href="#experience" class="hover:text-white transition-colors">Experience</a>
      <a href="#" class="p-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white transition-colors" aria-label="Back to top">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
