---
import { portfolioConfig } from '../data/portfolio';
---

<footer class="py-6 px-6 sm:px-10 lg:px-12 bg-[#050608] text-xs font-mono text-zinc-500 border-t border-white/[0.08] select-none">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Left Motto -->
    <div class="flex items-center gap-2 tracking-wider text-zinc-400 text-center sm:text-left">
      <span class="text-zinc-600">//</span>
      <span class="text-[11px] uppercase">BUILT WITH PASSION. FUELED BY WHITE MONSTER.</span>
    </div>

    <!-- Right Version & Return to Top -->
    <div class="flex items-center gap-6">
      <span class="text-[10px] tracking-widest text-zinc-500 font-mono">
        {portfolioConfig.personal.version}
      </span>

      <!-- Back to top button -->
      <a
        href="#home"
        aria-label="Return to top"
        class="w-7 h-7 border border-white/10 hover:border-white/40 flex items-center justify-center text-zinc-400 hover:text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
