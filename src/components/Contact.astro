---
import { portfolioConfig } from '../data/portfolio';
import sadSun from "@/assets/images/SadSun.png";
import kevin from "@/assets/images/KevinShopIdle.gif"

const { personal, socials } = portfolioConfig;
---

<section id="contact" class="py-16 sm:py-20 px-4 sm:px-10 lg:px-12 border-b border-white/[0.08] relative overflow-hidden">
  <!-- Section Tag -->
  <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 uppercase mb-8">
    <span class="text-zinc-600">//</span>
    <span>CONTACT</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center border border-white/10 bg-black/40 p-4 sm:p-8 relative overflow-hidden">
    <!-- Corner crosses -->
    <span class="absolute top-1 left-1 text-[8px] font-mono text-white/30">+</span>
    <span class="absolute top-1 right-1 text-[8px] font-mono text-white/30">+</span>
    <span class="absolute bottom-1 left-1 text-[8px] font-mono text-white/30">+</span>
    <span class="absolute bottom-1 right-1 text-[8px] font-mono text-white/30">+</span>

    <!-- Contact Info (Left 7 cols on desktop) -->
    <div class="lg:col-span-7 space-y-6 min-w-0 w-full">
      <div class="space-y-3 min-w-0 w-full">
        <h3 class="text-xl sm:text-2xl font-bold font-mono tracking-wider text-white uppercase break-words">
          INITIATE CONTACT SIGNAL
        </h3>
        <p class="text-xs sm:text-sm font-mono text-zinc-400 leading-relaxed max-w-lg break-words">
          Interested in game development collaborations, software engineering roles, or indie game design? Transmit a message directly into my inbox.
        </p>

        <!-- NPC Dialog / Kevin -->
        <div class="flex items-center gap-3 sm:gap-4 p-2.5 sm:p-3 border border-white/10 bg-black/50 relative overflow-hidden">
          <span class="absolute top-0.5 left-0.5 text-[8px] font-mono text-white/30">+</span>
          <span class="absolute bottom-0.5 right-0.5 text-[8px] font-mono text-white/30">+</span>

          <div class="w-14 h-18 sm:w-20 sm:h-24 flex-shrink-0 overflow-hidden border border-white/10 bg-black">
            <img
              src={kevin.src}
              alt="Kevin"
              draggable="false"
              class="w-full h-full object-cover object-bottom select-none pointer-events-none [image-rendering:pixelated]"
            />
          </div>
          <div class="space-y-1 min-w-0 flex-1">
            <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">// KEVIN.NPC</div>
            <p class="text-xs font-mono text-zinc-300 leading-relaxed break-words [overflow-wrap:anywhere]">
              "Yo! Looking for a game dev, designer, software engineering buddy, or anything IT related? Transmit your signal, because every bit of experience is beneficial for that young fella (he told me). YEEEEEEEEEEEEEEEEEEEEEEHAAAAAAAAAAAAAAAAWWWWWWWWWWW" :DDDDDDDDDDD
            </p>
          </div>
        </div>
      </div>

      <!-- Contact Details Stack -->
      <div class="space-y-3 font-mono text-xs text-zinc-300">
        <!-- Direct Email -->
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <a href={socials.email} class="hover:text-white transition-colors underline decoration-white/20">
            {personal.email}
          </a>
        </div>

        <!-- Location -->
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="text-zinc-400">{personal.location}</span>
        </div>

        <!-- Status -->
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="text-emerald-400 uppercase tracking-wider">{personal.status}</span>
        </div>
      </div>

      <!-- Action Button -->
      <div class="pt-2 flex items-center gap-4">
        <a
          href={socials.email}
          class="inline-flex items-center gap-2.5 px-6 py-3 border border-white/20 hover:border-white text-xs font-mono tracking-widest text-white hover:bg-white hover:text-black uppercase transition-all"
        >
          <span>GET IN TOUCH</span>
          <span>&rarr;</span>
        </a>

        <button
          id="copy-mail-btn"
          data-email={personal.email}
          type="button"
          class="text-xs font-mono text-zinc-500 hover:text-white transition-colors"
        >
          <span id="copy-mail-label">[ COPY EMAIL ]</span>
        </button>
      </div>
    </div>

    <!-- SadSun Illustration (Right 5 cols on desktop) -->
    <div class="lg:col-span-5 border border-white/10 bg-black/90 overflow-hidden group">
      <div class="relative w-full h-80 sm:h-96 overflow-hidden bg-black">
        <img
          src={sadSun.src}
          alt="Sad Sun illustration"
          draggable="false"
          class="w-full h-full object-cover object-[5%_12%] select-none pointer-events-none grayscale-[30%]"
        />
        <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      </div>
      <div class="px-3 py-1.5 border-t border-white/10 text-[9px] font-mono text-zinc-500 flex justify-between bg-black/60">
        <span>NIGHTMARE.SAD_SUN</span>
        <span>DREAMLAND ENTITY // THE LIGHT OF DREAMLAND</span>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-mail-btn');
  const label = document.getElementById('copy-mail-label');
  const mail = copyBtn?.getAttribute('data-email') || '';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(mail);
      if (label) {
        label.textContent = '[ COPIED TO CLIPBOARD! ]';
        setTimeout(() => {
          label.textContent = '[ COPY EMAIL ]';
        }, 2000);
      }
    } catch {
      if (label) {
        label.textContent = '[ COPIED! ]';
        setTimeout(() => {
          label.textContent = '[ COPY EMAIL ]';
        }, 2000);
      }
    }
  });
</script>
