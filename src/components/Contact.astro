---
import { portfolioData } from '../data/portfolio';

const { personal, socialLinks } = portfolioData;
---

<section id="contact" class="py-24 border-t border-white/[0.08] relative overflow-hidden">
  <!-- Subtle background blur highlight -->
  <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
    <div class="w-[500px] h-[350px] bg-indigo-600/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-indigo-400 bg-indigo-500/10 border border-indigo-500/20">
        Let's Connect
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Have a project in mind? <br />
        <span class="gradient-text">Let's build something together.</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-400 max-w-xl mx-auto leading-relaxed">
        Whether you have a question, an opportunity, or just want to say hi, my inbox is always open.
      </p>
    </div>

    <!-- Contact Box -->
    <div class="p-8 sm:p-10 rounded-2xl bg-gradient-to-b from-slate-900/90 to-[#0d1322] border border-white/[0.08] max-w-xl mx-auto space-y-6 shadow-2xl">
      <div class="space-y-2">
        <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Direct Email</span>
        <div class="text-xl sm:text-2xl font-mono font-bold text-white break-all">
          {personal.email}
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href={socialLinks.email}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-md shadow-indigo-500/20 hover:shadow-glow transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Send Message</span>
        </a>

        <button
          id="copy-email-btn"
          data-email={personal.email}
          type="button"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-800/90 hover:bg-slate-800 text-slate-200 hover:text-white font-medium border border-white/[0.08] transition-colors"
        >
          <svg id="copy-icon" class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span id="copy-text">Copy Email</span>
        </button>
      </div>

      <!-- Social links row -->
      <div class="pt-6 border-t border-white/[0.08] flex items-center justify-center gap-6 text-sm text-slate-400">
        <a
          href={socialLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors"
        >
          GitHub
        </a>
        <span class="text-white/20">•</span>
        <a
          href={socialLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors"
        >
          LinkedIn
        </a>
        {socialLinks.twitter && (
          <>
            <span class="text-white/20">•</span>
            <a
              href={socialLinks.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              Twitter / X
            </a>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const email = copyBtn?.getAttribute('data-email') || '';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) {
        copyText.textContent = 'Copied to clipboard!';
        setTimeout(() => {
          copyText.textContent = 'Copy Email';
        }, 2000);
      }
    } catch {
      // Fallback
      if (copyText) {
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy Email';
        }, 2000);
      }
    }
  });
</script>
