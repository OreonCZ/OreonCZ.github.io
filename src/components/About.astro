---
import { portfolioData } from '../data/portfolio';

const { personal } = portfolioData;
---

<section id="about" class="py-20 border-t border-white/[0.08] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-4 mb-12">
      <h2 class="text-xs uppercase tracking-widest text-indigo-400 font-semibold">About Me</h2>
      <h3 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Passionate about crafting exceptional digital experiences.
      </h3>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Bio text -->
      <div class="lg:col-span-7 space-y-5 text-slate-300 text-base sm:text-lg leading-relaxed">
        {personal.bio.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <div class="pt-4 flex flex-wrap gap-4 text-sm text-slate-300">
          <div class="flex items-center gap-2 bg-slate-900/60 border border-white/[0.08] px-4 py-2 rounded-lg">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Based in <strong class="text-white">{personal.location}</strong></span>
          </div>

          <div class="flex items-center gap-2 bg-slate-900/60 border border-white/[0.08] px-4 py-2 rounded-lg">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Available for <strong class="text-white">Full-Time & Contracts</strong></span>
          </div>
        </div>
      </div>

      <!-- Highlights Card -->
      <div class="lg:col-span-5 bg-gradient-to-b from-slate-900/80 to-slate-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl">
        <h4 class="text-lg font-semibold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          Core Principles
        </h4>

        <div class="space-y-4">
          <div class="flex items-start gap-3.5">
            <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <h5 class="text-sm font-semibold text-white">Performance-First</h5>
              <p class="text-xs sm:text-sm text-slate-400 mt-0.5">Optimizing load times, assets, and rendering pipelines for instant interactions.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
            </div>
            <div>
              <h5 class="text-sm font-semibold text-white">Maintainable Code</h5>
              <p class="text-xs sm:text-sm text-slate-400 mt-0.5">Writing typed, tested, and self-documenting code built for longevity.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h5 class="text-sm font-semibold text-white">Intuitive UX</h5>
              <p class="text-xs sm:text-sm text-slate-400 mt-0.5">Designing responsive layouts that feel natural across phones, tablets, and desktops.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
