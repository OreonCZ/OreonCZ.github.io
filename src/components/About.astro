---
import { portfolioConfig } from '../data/portfolio';
import KnightPortrait from './icons/KnightPortrait.astro';

const { personal, experiences } = portfolioConfig;
---

<section id="about" class="py-16 sm:py-20 px-6 sm:px-10 lg:px-12 border-b border-white/[0.08] relative">
  <!-- Section Tag -->
  <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 uppercase mb-8">
    <span class="text-zinc-600">//</span>
    <span>ABOUT ME</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start">
    <!-- Knight Avatar Frame -->
    <div class="md:col-span-4 lg:col-span-3 max-w-[240px] mx-auto md:mx-0 w-full">
      <KnightPortrait />
      <div class="pt-3 text-[10px] font-mono text-zinc-500 tracking-wider text-center md:text-left flex items-center justify-between">
        <span>// OreonCZ</span>
        <span class="text-zinc-600">⊂((・▽・))⊃</span>
      </div>
    </div>

    <!-- Bio Narrative -->
    <div class="md:col-span-8 lg:col-span-9 space-y-5 text-xs sm:text-sm font-mono text-zinc-300 leading-relaxed">
      {personal.bioParagraphs.map((para) => (
        <p class="text-zinc-400 leading-relaxed">
          {para}
        </p>
      ))}

      <!-- Key Details Row -->
      <div class="pt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        <div class="p-3 border border-white/[0.06] bg-white/[0.02]">
          <span class="text-zinc-500 block text-[10px] uppercase">Education</span>
          <strong class="text-white font-normal">SPSMB &rarr; VSB-TUO</strong>
        </div>
        <div class="p-3 border border-white/[0.06] bg-white/[0.02]">
          <span class="text-zinc-500 block text-[10px] uppercase">Specialty</span>
          <strong class="text-white font-normal">Game Dev &amp; Systems</strong>
        </div>
        <div class="p-3 border border-white/[0.06] bg-white/[0.02]">
          <span class="text-zinc-500 block text-[10px] uppercase">Familiar</span>
          <strong class="text-white font-normal">Kirby 🦎 (Bearded Dragon)</strong>
        </div>
      </div>

      <!-- Experience Log -->
      {experiences && experiences.length > 0 && (
        <div class="pt-4 space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 uppercase">
            <span class="text-zinc-600">//</span>
            <span>EXPERIENCE LOG</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs">
            {experiences.map((exp) => (
              <div class="p-3 border border-white/[0.08] bg-white/[0.02] space-y-1.5">
                <div class="flex items-start justify-between gap-2">
                  <span class="font-bold text-white tracking-wide">{exp.role}</span>
                  <span class="text-[10px] text-zinc-500 whitespace-nowrap">{exp.period}</span>
                </div>
                <div class="text-[11px] text-zinc-300 font-semibold">{exp.company}</div>
                <p class="text-[11px] text-zinc-400 leading-relaxed">
                  {exp.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Action Button: Download CV / Contact -->
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/myResume_FK.pdf`}
          target="_blank"
          download="filip_kucera_CV.pdf"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-white/20 hover:border-white text-xs font-mono tracking-wider text-white hover:bg-white hover:text-black transition-all"
        >
          <span>DOWNLOAD CV</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
        </a>

        <a
          href="#contact"
          class="text-xs font-mono text-zinc-500 hover:text-white transition-colors"
        >
          [ GET IN TOUCH ]
        </a>
      </div>
    </div>
  </div>
</section>
