---
import { portfolioConfig } from '../data/portfolio';
import GameplayScene from './icons/GameplayScene.astro';

const { personal } = portfolioConfig;
---

<section id="home" class="relative pt-8 pb-16 lg:pt-14 lg:pb-20 px-6 sm:px-10 lg:px-12 border-b border-white/[0.08]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
    <!-- Hero Text (Left 6-7 cols on desktop) -->
    <div class="lg:col-span-6 space-y-6">
      <!-- Terminal Tag -->
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 uppercase">
        <span class="text-zinc-600">//</span>
        <span>{personal.role}</span>
        <span class="w-1.5 h-1.5 rounded-full bg-white/40"></span>
        <span class="text-zinc-500">{personal.handle}</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white uppercase font-mono leading-[1.15]">
          {personal.tagline}
        </h1>
        <div class="w-16 h-0.5 bg-white/30"></div>
      </div>

      <!-- Subtitle Description -->
      <p class="text-xs sm:text-sm text-zinc-400 font-mono leading-relaxed max-w-xl">
        {personal.subtagline}
      </p>

      <!-- Action Button -->
      <div class="pt-4 flex items-center gap-4">
        <a
          href="#projects"
          class="inline-flex items-center gap-3 px-6 py-3 bg-white/[0.03] hover:bg-white text-white hover:text-black border border-white/20 hover:border-white text-xs font-mono tracking-widest uppercase transition-all duration-200 group"
        >
          <span>VIEW PROJECTS</span>
          <span class="group-hover:translate-x-1 transition-transform font-bold">+</span>
        </a>

        <a
          href={portfolioConfig.socials.steam}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-3 border border-white/10 hover:border-white/30 text-xs font-mono text-zinc-400 hover:text-white transition-colors"
        >
          <span>STEAM PROFILE</span>
          <span class="text-[10px]">↗</span>
        </a>
      </div>
    </div>

    <!-- Hero Gameplay Frame (Right 6 cols on desktop) -->
    <div class="lg:col-span-6">
      <GameplayScene />
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div class="pt-12 flex justify-center">
    <a
      href="#about"
      aria-label="Scroll to about me"
      class="text-zinc-500 hover:text-white transition-colors animate-bounce"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7" />
      </svg>
    </a>
  </div>
</section>
