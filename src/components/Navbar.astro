---
import { portfolioConfig } from '../data/portfolio';
import GothicSigil from './icons/GothicSigil.astro';

const navItems = [
  { num: '01', label: 'HOME', href: '#home' },
  { num: '02', label: 'ABOUT', href: '#about' },
  { num: '03', label: 'PROJECTS', href: '#projects' },
  { num: '04', label: 'SKILLS', href: '#skills' },
  { num: '05', label: 'CONTACT', href: '#contact' },
];
---

<!-- DESKTOP FIXED SIDEBAR -->
<aside class="hidden lg:flex flex-col justify-between w-64 xl:w-72 sticky top-0 h-screen p-8 bg-[#050608] select-none border-r border-white/[0.08] z-30">
  <!-- Top Brand / Logo -->
  <div class="space-y-8">
    <a href="#home" class="block group">
      <div class="flex items-center gap-3">
        <!-- Distressed Stencil OZ Logo -->
        <div class="w-12 h-12 bg-white/[0.04] border border-white/20 flex flex-col items-center justify-center font-extrabold tracking-tighter text-xl text-white group-hover:border-white transition-colors relative">
          <span class="leading-none text-2xl font-mono tracking-tighter">OZ</span>
          <span class="absolute -bottom-1 text-[7px] text-zinc-400 tracking-widest uppercase">GDEV</span>
        </div>
        <div>
          <div class="text-xl font-bold tracking-widest text-white leading-tight">OZ</div>
          <div class="text-[10px] tracking-[0.25em] text-zinc-400 font-mono">GAMEDEV</div>
        </div>
      </div>
    </a>

    <!-- Numbered Navigation Links -->
    <nav class="space-y-3 pt-6 border-t border-white/[0.08]">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link flex items-center gap-3 py-2 text-xs font-mono text-zinc-400 hover:text-white transition-all group"
        >
          <span class="text-[10px] text-zinc-600 group-hover:text-zinc-300 font-mono transition-colors">
            {item.num}
          </span>
          <span class="tracking-widest uppercase group-hover:translate-x-1 transition-transform">
            {item.label}
          </span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Bottom Details & Socials -->
  <div class="space-y-6 pt-6 border-t border-white/[0.08]">
    <!-- Social Icons -->
    <div class="flex items-center gap-3">
      <!-- GitHub -->
      <a
        href={portfolioConfig.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="w-8 h-8 rounded border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white/40 transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href={portfolioConfig.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="w-8 h-8 rounded border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white/40 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>

      <!-- Mail -->
      <a
        href={portfolioConfig.socials.email}
        aria-label="Send Email"
        class="w-8 h-8 rounded border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white/40 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>

      <!-- Steam -->
      <a
        href={portfolioConfig.socials.steam}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Steam Store Page"
        class="w-8 h-8 rounded border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white/40 transition-colors text-xs font-bold"
      >
        ST
      </a>
    </div>

    <!-- Copyright & Void Stamp -->
    <div class="space-y-1 text-[10px] font-mono text-zinc-500">
      <div>&copy; 2025 {portfolioConfig.personal.handle}</div>
      <div class="tracking-widest text-[9px] text-zinc-600">ALL RIGHTS VOID.</div>
    </div>

    <!-- Mini Gothic Sigil Decoration -->
    <div class="pt-2 opacity-30">
      <GothicSigil class="w-8 h-12" />
    </div>
  </div>
</aside>

<!-- MOBILE TOP BAR -->
<header class="lg:hidden sticky top-0 z-40 w-full bg-[#060709]/95 backdrop-blur-md border-b border-white/[0.08] px-4 py-3 flex items-center justify-between">
  <a href="#home" class="flex items-center gap-2">
    <div class="w-8 h-8 border border-white/20 flex items-center justify-center text-white font-mono text-sm font-bold">
      OZ
    </div>
    <span class="text-xs font-mono tracking-widest text-zinc-300">GAMEDEV</span>
  </a>

  <div class="flex items-center gap-3">
    <!-- Mini RPG souls count on mobile header -->
    <span class="text-[10px] font-mono text-zinc-400 border border-white/10 px-2 py-0.5 rounded">
      SOULS: {portfolioConfig.personal.souls}
    </span>

    <button
      id="mobile-nav-toggle"
      type="button"
      aria-label="Toggle Menu"
      class="p-2 border border-white/10 text-zinc-300 hover:text-white rounded"
    >
      <svg id="mob-menu-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="mob-menu-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Dropdown Menu -->
<div id="mobile-nav-drawer" class="lg:hidden hidden fixed inset-x-0 top-[53px] bg-[#060709] border-b border-white/[0.1] z-30 p-6 space-y-4 font-mono shadow-2xl">
  <nav class="space-y-3">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mob-nav-item block text-sm text-zinc-300 hover:text-white tracking-wider py-1.5 border-b border-white/[0.04]"
      >
        <span class="text-zinc-600 mr-2">{item.num}</span>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="pt-2 flex items-center justify-between text-xs text-zinc-500">
    <div class="flex items-center gap-3">
      <a href={portfolioConfig.socials.github} target="_blank" class="hover:text-white">GitHub</a>
      <span>•</span>
      <a href={portfolioConfig.socials.steam} target="_blank" class="hover:text-white">Steam</a>
      <span>•</span>
      <a href={portfolioConfig.socials.email} class="hover:text-white">Email</a>
    </div>
    <span class="text-[10px]">{portfolioConfig.personal.version}</span>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const openIcon = document.getElementById('mob-menu-open');
  const closeIcon = document.getElementById('mob-menu-close');
  const mobLinks = document.querySelectorAll('.mob-nav-item');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = drawer?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden', !isHidden);
    closeIcon?.classList.toggle('hidden', isHidden);
  });

  mobLinks.forEach((link) => {
    link.addEventListener('click', () => {
      drawer?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
