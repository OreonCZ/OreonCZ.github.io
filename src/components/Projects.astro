---
import { portfolioConfig } from '../data/portfolio';
import ProjectCard from './ProjectCard.astro';

const { projects, socials } = portfolioConfig;
---

<section id="projects" class="py-16 sm:py-20 px-6 sm:px-10 lg:px-12 border-b border-white/[0.08] relative">
  <!-- Section Header -->
  <div class="flex items-center justify-between mb-8">
    <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 uppercase">
      <span class="text-zinc-600">//</span>
      <span>PROJECTS</span>
    </div>

    <a
      href={socials.github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] font-mono tracking-wider text-zinc-400 hover:text-white flex items-center gap-1.5 transition-colors group"
    >
      <span>VIEW ALL PROJECTS</span>
      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
    </a>
  </div>

  <!-- Projects 5-card Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
