---
import type { ProjectItem } from '../data/portfolio';
import ProjectIcons from './icons/ProjectIcons.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class="group relative flex flex-col justify-between border border-white/10 hover:border-white/40 bg-black/40 hover:bg-black/80 p-5 transition-all duration-300">
  <!-- Corner crosses -->
  <span class="absolute top-1 left-1 text-[8px] font-mono text-white/30 leading-none select-none">+</span>
  <span class="absolute top-1 right-1 text-[8px] font-mono text-white/30 leading-none select-none">+</span>
  <span class="absolute bottom-1 left-1 text-[8px] font-mono text-white/30 leading-none select-none">+</span>
  <span class="absolute bottom-1 right-1 text-[8px] font-mono text-white/30 leading-none select-none">+</span>

  <div class="space-y-4">
    <!-- Project Icon Box -->
    <div class="h-24 flex items-center justify-center border-b border-white/[0.06] pb-3 text-white group-hover:scale-105 transition-transform duration-300">
      <ProjectIcons type={project.iconType} class="w-14 h-14" />
    </div>

    <!-- Title & Subtitle -->
    <div class="space-y-1">
      <h4 class="text-xs sm:text-sm font-bold font-mono tracking-wider text-white uppercase group-hover:text-zinc-200 transition-colors line-clamp-2">
        {project.title}
      </h4>
      <p class="text-[11px] font-mono text-zinc-500">
        {project.subtitle}
      </p>
    </div>

    <!-- Description -->
    <p class="text-[11px] font-mono text-zinc-400 leading-relaxed line-clamp-3">
      {project.description}
    </p>
  </div>

  <!-- Bottom CTA Link -->
  <div class="pt-4 mt-4 border-t border-white/[0.06] flex items-center justify-between">
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] font-mono tracking-wider text-zinc-400 group-hover:text-white flex items-center gap-1.5 transition-colors"
    >
      <span>{project.linkType}</span>
      <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
    </a>

    <!-- Mini tags -->
    <div class="flex items-center gap-1">
      {project.tags.slice(0, 2).map((tag) => (
        <span class="text-[9px] font-mono text-zinc-500 bg-white/[0.03] px-1.5 py-0.5 border border-white/[0.04]">
          {tag}
        </span>
      ))}
    </div>
  </div>
</article>
