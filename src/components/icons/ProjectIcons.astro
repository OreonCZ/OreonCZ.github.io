---
import catfighterLogo from "@/assets/images/GameLogo.png";
import breakoutLogo from "@/assets/images/breakout.png";
import steelwareLogo from "@/assets/images/steelware.png";
import trashitLogo from "@/assets/images/TrashIT.png";
import osucraftLogo from "@/assets/images/creeper.png";

interface Props {
  type: 'catfighter' | 'breakout' | 'osucraft' | 'steelware' | 'trashit' | 'dreamland';
  class?: string;
}

const { type, class: className = "w-14 h-14" } = Astro.props;

const imageMap = {
    dreamland: {
    src: catfighterLogo.src,
    alt: "Borders of Dreamland [next project in progress]",
    pixelated: false,
  },
  catfighter: {
    src: catfighterLogo.src,
    alt: "Catfighter: In the Lands of Sinners logo",
    pixelated: false,
  },
  breakout: {
    src: breakoutLogo.src,
    alt: "Breakout logo",
    pixelated: false,
  },
  osucraft: {
    src: osucraftLogo.src,
    alt: "OsuCraft logo",
    pixelated: true,
  },
  steelware: {
    src: steelwareLogo.src,
    alt: "Steelware.co logo",
    pixelated: false,
  },
  trashit: {
    src: trashitLogo.src,
    alt: "TrashIT logo",
    pixelated: true,
  },
};

const current = imageMap[type];
---

{current && (
  <img
    src={current.src}
    alt={current.alt}
    draggable="false"
    class={`object-contain select-none pointer-events-none grayscale-[50%] ${current.pixelated ? '[image-rendering:pixelated]' : ''} ${className}`}
  />
)}
