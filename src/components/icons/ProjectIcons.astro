---
interface Props {
  type: 'catfighter' | 'breakout' | 'osucraft' | 'steelware' | 'trashit';
  class?: string;
}

const { type, class: className = "w-16 h-16" } = Astro.props;
---

{type === 'catfighter' && (
  <!-- Catfighter: Gothic Cat Skull & Crossed Daggers Crest -->
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Crossed Greatswords -->
    <line x1="12" y1="12" x2="52" y2="52" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="52" y1="12" x2="12" y2="52" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="14" y1="18" x2="18" y2="14" stroke="#9ca3af" stroke-width="2"/>
    <line x1="46" y1="14" x2="50" y2="18" stroke="#9ca3af" stroke-width="2"/>
    <!-- Cat Skull / Crest Face -->
    <path d="M22 26 L20 16 L28 22 L36 22 L44 16 L42 26 L46 36 L40 46 L24 46 L18 36 Z" fill="#0b0d13" stroke="white" stroke-width="2"/>
    <!-- Triangular/Slanted Eyes -->
    <polygon points="25,31 30,34 26,36" fill="white"/>
    <polygon points="39,31 34,34 38,36" fill="white"/>
    <!-- Nose & Teeth -->
    <polygon points="31,39 33,39 32,41" fill="white"/>
    <line x1="28" y1="44" x2="36" y2="44" stroke="white" stroke-width="1.5"/>
    <line x1="30" y1="42" x2="30" y2="45" stroke="white" stroke-width="1.5"/>
    <line x1="34" y1="42" x2="34" y2="45" stroke="white" stroke-width="1.5"/>
  </svg>
)}

{type === 'breakout' && (
  <!-- Breakout: Retro 2D Arcade Paddle & Ball -->
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Brick row at top -->
    <rect x="8" y="14" width="10" height="4" fill="white" fill-opacity="0.9"/>
    <rect x="20" y="14" width="10" height="4" fill="white" fill-opacity="0.9"/>
    <rect x="32" y="14" width="10" height="4" fill="white" fill-opacity="0.9"/>
    <rect x="44" y="14" width="10" height="4" fill="white" fill-opacity="0.9"/>
    <!-- Bouncing Ball with trajectory trail -->
    <line x1="26" y1="36" x2="36" y2="24" stroke="white" stroke-dasharray="2 2" stroke-opacity="0.5"/>
    <rect x="35" y="22" width="4" height="4" fill="white"/>
    <!-- Paddle at bottom -->
    <rect x="18" y="44" width="28" height="5" rx="1" fill="white"/>
  </svg>
)}

{type === 'osucraft' && (
  <!-- OsuCraft: Creeper Pixel Face Grid -->
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
    <!-- Creeper 8x8 Head -->
    <rect x="12" y="12" width="40" height="40" fill="#181c24" stroke="white" stroke-width="2"/>
    <!-- Eyes -->
    <rect x="18" y="22" width="8" height="8" fill="white"/>
    <rect x="38" y="22" width="8" height="8" fill="white"/>
    <!-- Nose / Center Mouth -->
    <rect x="27" y="30" width="10" height="10" fill="white"/>
    <!-- Lower Mouth Extensions -->
    <rect x="23" y="35" width="4" height="13" fill="white"/>
    <rect x="37" y="35" width="4" height="13" fill="white"/>
  </svg>
)}

{type === 'steelware' && (
  <!-- Steelware.co: FNAF Robot Endoskeleton Skull -->
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Animatronic Skull Base -->
    <rect x="18" y="18" width="28" height="24" rx="4" fill="#0b0d13" stroke="white" stroke-width="2"/>
    <!-- Large Round Eye Sockets -->
    <circle cx="26" cy="27" r="5" stroke="white" stroke-width="1.5"/>
    <circle cx="38" cy="27" r="5" stroke="white" stroke-width="1.5"/>
    <!-- Glowing Pinpoint Pupils -->
    <circle cx="26" cy="27" r="2" fill="white"/>
    <circle cx="38" cy="27" r="2" fill="white"/>
    <!-- Exposed Jaw with Steel Teeth -->
    <rect x="22" y="44" width="20" height="8" fill="#0b0d13" stroke="white" stroke-width="1.5"/>
    <line x1="26" y1="44" x2="26" y2="52" stroke="white" stroke-width="1.5"/>
    <line x1="32" y1="44" x2="32" y2="52" stroke="white" stroke-width="1.5"/>
    <line x1="38" y1="44" x2="38" y2="52" stroke="white" stroke-width="1.5"/>
    <!-- Neck Piston / Wires -->
    <line x1="28" y1="52" x2="28" y2="58" stroke="white" stroke-width="2"/>
    <line x1="36" y1="52" x2="36" y2="58" stroke="white" stroke-width="2"/>
  </svg>
)}

{type === 'trashit' && (
  <!-- TrashIT: Pixel Electro Bin with Lightning -->
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Circular Badge Frame -->
    <circle cx="32" cy="32" r="24" stroke="white" stroke-width="1.5" stroke-dasharray="3 3"/>
    <!-- Bin Lid & Handle -->
    <rect x="28" y="16" width="8" height="3" fill="white"/>
    <rect x="20" y="20" width="24" height="4" rx="1" fill="white"/>
    <!-- Bin Body -->
    <path d="M22 25 L25 48 L39 48 L42 25 Z" fill="#0b0d13" stroke="white" stroke-width="2"/>
    <!-- Lightning Bolt Icon inside Bin -->
    <polygon points="33,28 28,37 32,37 31,45 36,35 32,35" fill="white"/>
  </svg>
)}
