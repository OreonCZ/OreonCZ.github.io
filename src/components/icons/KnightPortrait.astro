---
import me from "@/assets/images/me.png"

interface Props {
  class?: string;
}
const { class: className = "w-full h-auto" } = Astro.props;
---

<div class={`relative border border-white/20 bg-black/80 overflow-hidden ${className}`}>
  <!-- Viewfinder corners -->
  <span class="absolute top-1 left-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>
  <span class="absolute top-1 right-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>
  <span class="absolute bottom-1 left-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>
  <span class="absolute bottom-1 right-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>

<img src={me.src} alt="Gameplay preview" draggable="false" class="select-none pointer-events-none grayscale"/>


</div>
