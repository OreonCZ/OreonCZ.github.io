---
interface Props {
  class?: string;
}
const { class: className = "w-full h-auto" } = Astro.props;
---

<div class={`relative border border-white/20 bg-black/80 overflow-hidden ${className}`}>
  <!-- Viewfinder corners -->
  <span class="absolute top-1 left-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>
  <span class="absolute top-1 right-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>
  <span class="absolute bottom-1 left-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>
  <span class="absolute bottom-1 right-1 text-[9px] font-mono text-white/40 leading-none select-none">+</span>

  <svg class="w-full h-auto aspect-square block" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="knightGlow" cx="50%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#2d3748" stop-opacity="0.8"/>
        <stop offset="100%" stop-color="#050608" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="metalShine" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e2e8f0"/>
        <stop offset="50%" stop-color="#475569"/>
        <stop offset="100%" stop-color="#0f172a"/>
      </linearGradient>
    </defs>

    <!-- Dark Vignette Background -->
    <rect width="200" height="200" fill="url(#knightGlow)"/>

    <!-- Spiked Pauldrons (Shoulders) -->
    <!-- Left shoulder -->
    <path d="M20 200 L40 140 L70 145 L85 200 Z" fill="#1e293b"/>
    <polygon points="35,135 15,115 45,130" fill="url(#metalShine)"/>
    <polygon points="50,132 35,105 60,125" fill="url(#metalShine)"/>
    <!-- Right shoulder -->
    <path d="M180 200 L160 140 L130 145 L115 200 Z" fill="#1e293b"/>
    <polygon points="165,135 185,115 155,130" fill="url(#metalShine)"/>
    <polygon points="150,132 165,105 140,125" fill="url(#metalShine)"/>

    <!-- Chestplate / Gorget -->
    <path d="M70 140 L100 130 L130 140 L120 200 L80 200 Z" fill="#0f172a"/>
    <path d="M75 145 L100 136 L125 145 L115 195 L85 195 Z" fill="#334155"/>
    <line x1="100" y1="135" x2="100" y2="195" stroke="#94a3b8" stroke-width="1.5"/>

    <!-- Neck & Helmet Base -->
    <path d="M82 110 L100 125 L118 110 L115 135 L85 135 Z" fill="#1e293b"/>

    <!-- Greathelm / Sallet Helmet -->
    <path d="M74 85 C74 50 126 50 126 85 C126 110 114 118 100 122 C86 118 74 110 74 85 Z" fill="#1e293b"/>
    <path d="M78 85 C78 55 122 55 122 85 C122 106 112 114 100 118 C88 114 78 106 78 85 Z" fill="url(#metalShine)"/>

    <!-- Helmet Crest / Spikes -->
    <polygon points="100,32 94,55 106,55" fill="#f8fafc"/>
    <polygon points="85,42 82,60 92,58" fill="#cbd5e1"/>
    <polygon points="115,42 118,60 108,58" fill="#cbd5e1"/>

    <!-- Helmet Ridge -->
    <line x1="100" y1="52" x2="100" y2="116" stroke="#f1f5f9" stroke-width="2"/>

    <!-- Visor Slit (Dark Shadow with Glowing Core) -->
    <path d="M84 86 L100 90 L116 86 L114 91 L100 95 L86 91 Z" fill="#020617"/>
    <!-- Intense Glowing Gaze -->
    <line x1="88" y1="88" x2="96" y2="89" stroke="#ffffff" stroke-width="2"/>
    <line x1="104" y1="89" x2="112" y2="88" stroke="#ffffff" stroke-width="2"/>

    <!-- Breathing Grille Dots -->
    <circle cx="95" cy="104" r="1" fill="#0f172a"/>
    <circle cx="100" cy="104" r="1" fill="#0f172a"/>
    <circle cx="105" cy="104" r="1" fill="#0f172a"/>
    <circle cx="97" cy="108" r="1" fill="#0f172a"/>
    <circle cx="103" cy="108" r="1" fill="#0f172a"/>

    <!-- Atmospheric Noise / Scratches -->
    <line x1="40" y1="60" x2="60" y2="65" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1"/>
    <line x1="140" y1="80" x2="165" y2="75" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1"/>
  </svg>
</div>
