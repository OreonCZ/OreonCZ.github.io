  <circle cx="88" cy="53" r="1.5" fill="white" fill-opacity="0.8"/>
  <circle cx="50" cy="138" r="1.5" fill="white" fill-opacity="0.8"/>
  <circle cx="50" cy="3" r="1.5" fill="white"/>
  
  <!-- Symmetrical side spikes -->
  <line x1="28" y1="44" x2="16" y2="38" stroke="white" stroke-width="1.2" stroke-opacity="0.6"/>
  <line x1="72" y1="44" x2="84" y2="38" stroke="white" stroke-width="1.2" stroke-opacity="0.6"/>
  <line x1="26" y1="72" x2="14" y2="78" stroke="white" stroke-width="1.2" stroke-opacity="0.6"/>
  <line x1="74" y1="72" x2="86" y2="78" stroke="white" stroke-width="1.2" stroke-opacity="0.6"/>
</svg>
