  <path d="M14 50L22 53L14 56L18 53L14 50Z" fill="white"/>
  <path d="M86 50L78 53L86 56L82 53L86 50Z" fill="white"/>

  <!-- Upper Crown Thorns -->
  <path d="M50 20L36 34L44 35L50 26L56 35L64 34L50 20Z" fill="white" fill-opacity="0.6"/>
  <path d="M50 12L30 26L38 28L50 18L62 28L70 26L50 12Z" fill="white" fill-opacity="0.4"/>

