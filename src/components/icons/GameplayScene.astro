---
interface Props {
  class?: string;
}
const { class: className = "w-full h-auto" } = Astro.props;
---

<div class={`relative border border-white/20 bg-black overflow-hidden select-none group ${className}`}>
  <!-- Viewfinder corners -->
  <span class="absolute top-1 left-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>
  <span class="absolute top-1 right-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>
  <span class="absolute bottom-1 left-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>
  <span class="absolute bottom-1 right-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>

  <!-- Top label indicator -->
  <div class="absolute top-2 left-3 z-10 text-[10px] font-mono text-white/60 tracking-wider flex items-center gap-1.5">
    <span>+ // GAMEPLAY.GIF</span>
    <span class="w-1.5 h-1.5 rounded-full bg-red-500/80 animate-pulse ml-1"></span>
  </div>

  <!-- Retro Canvas / Pixel scene -->
  <svg class="w-full h-auto aspect-[16/9] block" viewBox="0 0 640 360" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="moonGlow" cx="68%" cy="42%" r="35%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
        <stop offset="40%" stop-color="#d1d5db" stop-opacity="0.6"/>
        <stop offset="85%" stop-color="#4b5563" stop-opacity="0.15"/>
        <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="nightSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#040507"/>
        <stop offset="100%" stop-color="#0b0d13"/>
      </linearGradient>
      <!-- Pixel Pattern Grid -->
      <pattern id="pixelGrid" width="4" height="4" patternUnits="userSpaceOnUse">
        <rect width="2" height="2" fill="white" fill-opacity="0.015"/>
      </pattern>
    </defs>

    <!-- Sky Background -->
    <rect width="640" height="360" fill="url(#nightSky)"/>
    <rect width="640" height="360" fill="url(#pixelGrid)"/>

    <!-- Glowing Full Moon -->
    <circle cx="430" cy="150" r="110" fill="url(#moonGlow)"/>
    <circle cx="430" cy="150" r="70" fill="#e5e7eb" fill-opacity="0.85"/>
    <!-- Moon Cratering / Dither texture -->
    <circle cx="410" cy="130" r="14" fill="#9ca3af" fill-opacity="0.3"/>
    <circle cx="445" cy="165" r="22" fill="#9ca3af" fill-opacity="0.3"/>
    <circle cx="395" cy="170" r="10" fill="#9ca3af" fill-opacity="0.25"/>

    <!-- Background Gnarled Trees & Pillars -->
    <g fill="#0b0c10" fill-opacity="0.8">
      <!-- Left Forest -->
      <path d="M40 360L55 120L62 360Z"/>
      <path d="M75 360L85 100L95 360Z"/>
      <path d="M120 360L135 140L145 360Z"/>
      <path d="M160 360L175 90L190 360Z"/>
      <path d="M220 360L230 160L245 360Z"/>
      <!-- Right Forest Silhouette -->
      <path d="M530 360L545 110L560 360Z"/>
      <path d="M575 360L585 130L600 360Z"/>
      <path d="M610 360L625 90L640 360Z"/>
    </g>

    <!-- Fog and Mist Layers -->
    <path d="M0 320 Q 180 290 360 325 T 640 310 L 640 360 L 0 360 Z" fill="#11131a" fill-opacity="0.6"/>

    <!-- Mound of Skulls / Rock Crag where Boss Stands -->
    <path d="M310 360L350 260L420 230L490 250L530 360Z" fill="#090a0f"/>
    <path d="M330 360L370 280L430 255L480 270L510 360Z" fill="#141720"/>

    <!-- THE HORNED BOSS (Giant Souls Lord) -->
    <g transform="translate(425, 205)">
      <!-- Massive flowing cloak -->
      <path d="M-55 70 Q -65 15 -35 -20 Q 0 -45 35 -20 Q 65 15 55 70 Q 20 85 0 80 Q -30 85 -55 70Z" fill="#040406"/>
      <path d="M-45 65 Q -55 20 -25 -10 Q 0 -30 25 -10 Q 55 20 45 65 Z" fill="#0a0c10"/>
      <!-- Spiked Shoulders -->
      <path d="M-45 -10 L -60 -25 L -35 -15 Z" fill="#d1d5db" fill-opacity="0.8"/>
      <path d="M45 -10 L 60 -25 L 35 -15 Z" fill="#d1d5db" fill-opacity="0.8"/>
      <!-- Body Armor / Ribs -->
      <rect x="-16" y="-15" width="32" height="42" rx="3" fill="#161922"/>
      <line x1="-12" y1="-5" x2="12" y2="-5" stroke="#4b5563" stroke-width="2"/>
      <line x1="-10" y1="5" x2="10" y2="5" stroke="#4b5563" stroke-width="2"/>
      <line x1="-8" y1="15" x2="8" y2="15" stroke="#4b5563" stroke-width="2"/>
      <!-- Horned Helmet -->
      <ellipse cx="0" cy="-35" rx="14" ry="16" fill="#1e222e"/>
      <!-- Giant Sweeping Curved Horns -->
      <path d="M-12 -38 Q -40 -60 -36 -82 Q -22 -66 -6 -48 Z" fill="#ffffff"/>
      <path d="M12 -38 Q 40 -60 36 -82 Q 22 -66 6 -48 Z" fill="#ffffff"/>
      <path d="M-8 -38 Q -24 -55 -22 -68 Q -14 -55 -4 -44 Z" fill="#9ca3af"/>
      <path d="M8 -38 Q 24 -55 22 -68 Q 14 -55 4 -44 Z" fill="#9ca3af"/>
      <!-- Glowing Red/White Eyes in Visor -->
      <rect x="-6" y="-36" width="4" height="2" fill="#ffffff"/>
      <rect x="2" y="-36" width="4" height="2" fill="#ffffff"/>
      <!-- Great Staff / Polearm Held in Right Hand -->
      <line x1="-42" y1="65" x2="-26" y2="-90" stroke="#d1d5db" stroke-width="2.5"/>
      <polygon points="-26,-95 -32,-78 -20,-78" fill="#ffffff"/>
    </g>

    <!-- THE HERO KNIGHT (Foreground Left) -->
    <g transform="translate(240, 245)">
      <!-- Cape -->
      <path d="M-12 15 Q -32 40 -25 65 Q -8 50 2 30 Z" fill="#141722"/>
      <!-- Plate Armor Body -->
      <rect x="-8" y="10" width="18" height="26" rx="2" fill="#374151"/>
      <path d="M-12 12 L -6 8 L -4 18 Z" fill="#9ca3af"/>
      <path d="M8 12 L 14 8 L 12 18 Z" fill="#9ca3af"/>
      <!-- Legs in Stride/Combat Stance -->
      <line x1="-4" y1="36" x2="-14" y2="70" stroke="#4b5563" stroke-width="5" stroke-linecap="round"/>
      <line x1="6" y1="36" x2="16" y2="68" stroke="#374151" stroke-width="5" stroke-linecap="round"/>
      <!-- Knight Helm with Feather / Plume -->
      <circle cx="1" cy="0" r="9" fill="#9ca3af"/>
      <rect x="-2" y="-1" width="9" height="3" fill="#111827"/>
      <path d="M-3 -8 Q -12 -16 -8 -22 Q -4 -16 0 -9 Z" fill="#e5e7eb"/>
      <!-- Drawn Sword Raised -->
      <line x1="12" y1="20" x2="38" y2="-2" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
      <!-- Sword Glow Crossguard -->
      <line x1="16" y1="14" x2="10" y2="20" stroke="#e5e7eb" stroke-width="2"/>
    </g>

    <!-- Floating Embers / Sparks -->
    <circle cx="340" cy="220" r="1.5" fill="#ffffff" fill-opacity="0.8"/>
    <circle cx="380" cy="180" r="1" fill="#ffffff" fill-opacity="0.9"/>
    <circle cx="470" cy="160" r="1" fill="#ffffff" fill-opacity="0.7"/>
    <circle cx="280" cy="210" r="1.5" fill="#ffffff" fill-opacity="0.8"/>
    <circle cx="490" cy="210" r="1" fill="#ffffff" fill-opacity="0.6"/>
    <circle cx="310" cy="170" r="1" fill="#ffffff" fill-opacity="0.7"/>

    <!-- Ground Foreground Silhouette -->
    <path d="M0 310 Q 140 315 260 320 Q 380 325 500 320 Q 580 325 640 315 L 640 360 L 0 360 Z" fill="#06070a"/>
  </svg>

  <!-- Scanline sweep effect overlay -->
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-white/[0.02] to-transparent opacity-60"></div>
</div>
