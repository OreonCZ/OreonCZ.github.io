---
import PosterArtTemplate from "@/assets/images/PosterArtTemplate.png"

interface Props {
  class?: string;
}
const { class: className = "w-full h-auto" } = Astro.props;
---

<div class={`relative border border-white/20 bg-black overflow-hidden select-none group ${className}`}>
  <!-- Viewfinder corners -->
  <span class="absolute top-1 left-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>
  <span class="absolute top-1 right-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>
  <span class="absolute bottom-1 left-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>
  <span class="absolute bottom-1 right-1 text-[10px] font-mono text-white/50 leading-none select-none">+</span>

  <!-- Top label indicator -->
  <div class="absolute top-2 left-3 z-10 text-[18px] font-mono text-white/100 tracking-wider flex items-center gap-1.5">
    <span>+ REC </span>
    <span class="w-1.5 h-1.5 rounded-full bg-red-500/80 animate-pulse ml-1"></span>
  </div>

  <!-- Retro Canvas / Pixel scene -->
  <img src={PosterArtTemplate.src} alt="Gameplay preview" draggable="false" class="select-none pointer-events-none grayscale-[60%] contrast-[80%] brightness-[90%]"/>

  <!-- Scanline sweep effect overlay -->
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-white/[0.02] to-transparent opacity-60"></div>
</div>
