---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { portfolioConfig } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${portfolioConfig.personal.brand} | ${portfolioConfig.personal.name} - ${portfolioConfig.personal.role}`,
  description = portfolioConfig.personal.subtagline
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060709" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Fonts: JetBrains Mono & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#060709] text-slate-200 min-h-screen relative antialiased selection:bg-white selection:text-black font-mono overflow-x-hidden w-full">
    <!-- Subtle Background Scanlines & Dark Vignette -->
    <div class="fixed inset-0 pointer-events-none z-50 hud-scanlines opacity-40"></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-zinc-900/20 via-[#060709] to-[#040406]"></div>

    <!-- Outer Wrapper with Window Border feel -->
    <div class="min-h-screen flex flex-col lg:flex-row max-w-[1720px] mx-auto border-x border-white/[0.08] relative w-full overflow-x-hidden">
      <!-- Navigation (Desktop Fixed Sidebar + Mobile Top Bar) -->
      <Navbar />

      <!-- Main Content Area -->
      <div class="flex-1 flex flex-col min-w-0 w-full overflow-x-hidden lg:border-l border-white/[0.08]">
        <!-- Top Window Bar -->
        <div class="hidden lg:flex items-center justify-between px-6 py-2.5 border-b border-white/[0.08] bg-[#07090d]/90 text-xs text-slate-400 select-none">
          <div class="flex items-center gap-3 font-mono text-[11px]">
            <span class="text-[10px] text-zinc-500">// SYSTEM.ONLINE</span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-zinc-600">|</span>
            <span class="text-zinc-300">{portfolioConfig.personal.name}</span>
            <span class="text-zinc-600">//</span>
            <span class="text-zinc-400">{portfolioConfig.personal.role}</span>
          </div>

          <div class="flex items-center gap-4">
            <span class="text-[10px] font-mono text-zinc-500">{portfolioConfig.personal.location}</span>
            <!-- Window frame minimize / close buttons -->
            <div class="flex items-center gap-3 border-l border-white/10 pl-4 text-slate-400">
              <span class="hover:text-white transition-colors cursor-default select-none">_</span>
              <span class="hover:text-red-400 transition-colors cursor-default select-none">✕</span>
            </div>
          </div>
        </div>

        <!-- Page Sections -->
        <main class="flex-grow">
          <slot />
        </main>

        <!-- Bottom HUD Ticker & Footer -->
        <Footer />
      </div>
    </div>
  </body>
</html>
